# Contact / project / demo form delivery (pick one; with neither, the form shows an honest error)
RESEND_API_KEY=
CONTACT_TO=hello@aimebase.com
CONTACT_FROM="AImbase website <website@aimebase.com>"
# or forward submissions as JSON to Zapier, Make, Slack, a CRM…
CONTACT_WEBHOOK_URL=

# Booking page (Cal.com, Calendly…). When set, /demo and the contact page embed it inline.
NEXT_PUBLIC_CALENDAR_LINK=

# Review mode: show dashed chips for any [BRACKET] value left in content/projects/*.md
NEXT_PUBLIC_SHOW_PLACEHOLDERS=false
