# Supply-chain hardening (npm worm campaigns like Shai-Hulud spread through install scripts
# and freshly published malicious versions).
# Never run dependency lifecycle scripts (preinstall/install/postinstall). Nothing here needs them.
ignore-scripts=true
# Refuse package versions published less than 3 days ago; hijacked releases are usually pulled within hours.
minimum-release-age=4320
# Install exactly what the lockfile pins.
frozen-lockfile=true
